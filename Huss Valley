Hub.cleanup = function()
    if Hub.cleaned then return end
    Hub.cleaned = true
    for key, value in pairs(SETTINGS) do
        if type(value) == "boolean" then SETTINGS[key] = false end
    end
    pcall(cancelRevive)
    pcall(function() RunService:UnbindFromRenderStep("CoH_StableController") end)
    pcall(function() RunService:UnbindFromRenderStep("CoH_SpeedOverride") end)
    pcall(restoreNativeWalkSpeed)
    pcall(cleanupVisuals)
    pcall(function() screenGui:Destroy() end)
    if Hub.genv.HussValleyUnload == Hub.cleanup then
        Hub.genv.HussValleyUnload = nil
    end
end
