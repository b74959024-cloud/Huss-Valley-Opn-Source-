-- START BACKGROUND LOOP
-- ============================================================
RunService:UnbindFromRenderStep("CoH_SpeedOverride")
RunService:BindToRenderStep("CoH_SpeedOverride", Enum.RenderPriority.Input.Value + 2, function()
    if Hub.cleaned then return end
    local role = getRole()
    local character = getCharacter()
    local hum = getHumanoid()
    if not character or not hum or hum.Health <= 0 then return end
    local state = character:GetAttribute("MovementState")
    if state == "Dashing" or state == "Boosting" then return end
    local nativeOutput = tonumber(character:GetAttribute("MovementSpeed"))
    if nativeOutput and nativeOutput > 0 then
        local desiredSpeed = nativeOutput
        if role == "Runner" and SETTINGS.customSpeed and SETTINGS.speedMultiplier > 1.0001 then
            desiredSpeed = nativeOutput * math.clamp(SETTINGS.speedMultiplier, 1, 2)
        elseif role == "Catcher" and SETTINGS.catcherCustomSpeed and SETTINGS.catcherSpeedMultiplier > 1.0001 then
            desiredSpeed = nativeOutput * math.clamp(SETTINGS.catcherSpeedMultiplier, 1, 2)
        end
        if math.abs(hum.WalkSpeed - desiredSpeed) > 0.05 then
            hum.WalkSpeed = desiredSpeed
        end
    end
end)

RunService:UnbindFromRenderStep("CoH_StableController")
local controllerInterval = IS_MOBILE and (1 / 30) or 0
local lastControllerTick = os.clock()

RunService:BindToRenderStep("CoH_StableController", Enum.RenderPriority.Input.Value, function(dt)
    if Hub.cleaned then return end
    local now = os.clock()
    if now - lastControllerTick >= controllerInterval then
        local controllerDt = math.max(dt, now - lastControllerTick)
        lastControllerTick = now
        pcall(runnerStep, now, controllerDt)
        pcall(catcherStep, now, controllerDt)
    end
    if now - runtime.utilityTick >= UTILITY_INTERVAL then
        runtime.utilityTick = now
        pcall(utilityStep, now)
    end
    if runtime.debugEnabled and now - (runtime.debugPanelAt or -math.huge) >= 0.1 then
        runtime.debugPanelAt = now
        pcall(updateDebugPanel, now)
    end
end)

